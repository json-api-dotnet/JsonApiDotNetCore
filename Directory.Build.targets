<Project>
  <Target Name="DisableCompileTimeOpenApiXmlGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Microsoft.AspNetCore.OpenApi.SourceGenerators'" />
    </ItemGroup>
  </Target>

  <!-- Workaround for compiler regression at https://github.com/dotnet/roslyn/issues/80756 -->
  <Target Name="DisableSlowAnalyzers" Condition="'$(Configuration)' == 'Debug'" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Microsoft.CodeAnalysis.CSharp.CodeStyle'" />
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Microsoft.CodeAnalysis.NetAnalyzers'" />
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Microsoft.CodeAnalysis.CSharp.NetAnalyzers'" />
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'xunit.analyzers'" />
    </ItemGroup>
  </Target>

  <!--
    Workaround for Coverlet 8.0.1: NetCoreSharedFrameworkResolver only searches for <ModuleName>.runtimeconfig.json
    to resolve shared framework assemblies (Microsoft.AspNetCore.App) for Cecil during instrumentation.
    For class libraries, no such file exists by default, causing Cecil to fail resolving Microsoft.Extensions.Logging.Abstractions.
    Copying the test project's runtimeconfig.json as JsonApiDotNetCore.runtimeconfig.json provides the resolver with the needed framework paths.
  -->
  <Target Name="CopyRuntimeConfigForCoverlet"
    Condition="($(MSBuildProjectName.EndsWith('Tests')) Or '$(MSBuildProjectName)' == 'TestBuildingBlocks') And '$(GenerateRuntimeConfigurationFiles)' == 'true' And Exists('$(ProjectRuntimeConfigFilePath)')"
    AfterTargets="GenerateBuildRuntimeConfigurationFiles">
    <Copy SourceFiles="$(ProjectRuntimeConfigFilePath)" DestinationFiles="$(TargetDir)JsonApiDotNetCore.runtimeconfig.json" SkipUnchangedFiles="true" />
  </Target>
</Project>
